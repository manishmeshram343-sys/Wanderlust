
<% layout("/layouts/boilerplate") %>

<!-- Hero Section -->
<section class="hero text-center text-white d-flex align-items-center">
    <div class="container">
        <h1 class="display-3 fw-bold">Find Your Next Perfect Stay</h1>
        <p class="lead mt-3">
            Discover unique homes, luxury villas, cozy cabins, and unforgettable
            travel experiences around the world.
        </p>

        <a href="/listings" class="btn btn-danger btn-lg mt-3 px-4">
            Explore Listings
        </a>
    </div>
</section>

<!-- Search -->
<section class="container mt-5">
    <div class="card shadow-lg border-0 p-4">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Where are you going?">
            </div>

            <div class="col-md-2">
                <input type="date" class="form-control">
            </div>

            <div class="col-md-2">
                <input type="date" class="form-control">
            </div>

            <div class="col-md-2">
                <input type="number" class="form-control" placeholder="Guests">
            </div>

            <div class="col-md-2">
                <button class="btn btn-danger w-100">
                    Search
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Categories -->
<section class="container mt-5">
    <h2 class="text-center mb-4">Explore Categories</h2>

    <div class="row text-center">

        <div class="col-md-2 col-4 mb-4">
            <i class="fa-solid fa-water fa-2x"></i>
            <p>Beach</p>
        </div>

        <div class="col-md-2 col-4 mb-4">
            <i class="fa-solid fa-mountain fa-2x"></i>
            <p>Mountain</p>
        </div>

        <div class="col-md-2 col-4 mb-4">
            <i class="fa-solid fa-tree fa-2x"></i>
            <p>Forest</p>
        </div>

        <div class="col-md-2 col-4 mb-4">
            <i class="fa-solid fa-campground fa-2x"></i>
            <p>Camping</p>
        </div>

        <div class="col-md-2 col-4 mb-4">
            <i class="fa-solid fa-city fa-2x"></i>
            <p>City</p>
        </div>

        <div class="col-md-2 col-4 mb-4">
            <i class="fa-solid fa-house fa-2x"></i>
            <p>Villa</p>
        </div>

    </div>
</section>

<!-- Why Choose -->
<section class="container mt-5">

    <h2 class="text-center mb-5">Why Choose WanderLust?</h2>

    <div class="row">

        <div class="col-md-4 text-center">
            <i class="fa-solid fa-house-user fa-3x text-danger"></i>
            <h4 class="mt-3">Unique Homes</h4>
            <p>
                Stay in beautiful apartments, villas,
                beach houses and mountain cabins.
            </p>
        </div>

        <div class="col-md-4 text-center">
            <i class="fa-solid fa-earth-asia fa-3x text-danger"></i>
            <h4 class="mt-3">Worldwide</h4>
            <p>
                Thousands of destinations available
                across the globe.
            </p>
        </div>

        <div class="col-md-4 text-center">
            <i class="fa-solid fa-star fa-3x text-danger"></i>
            <h4 class="mt-3">Trusted Hosts</h4>
            <p>
                Verified hosts with genuine reviews
                for safe and secure stays.
            </p>
        </div>

    </div>

</section>

<!-- Become Host -->
<section class="container mt-5">
    <div class="bg-danger text-white text-center rounded p-5">

        <h2>Become a Host</h2>

        <p class="mt-3">
            Earn extra income by sharing your home with travelers.
        </p>

        <button class="btn btn-light btn-lg">
            Start Hosting
        </button>

    </div>
</section>

<!-- Testimonials -->
<section class="container mt-5">

    <h2 class="text-center mb-4">
        What Our Guests Say
    </h2>

    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    ⭐⭐⭐⭐⭐
                    <p class="mt-3">
                        Amazing experience! Easy booking and beautiful place.
                    </p>
                    <strong>- Rahul</strong>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    ⭐⭐⭐⭐⭐
                    <p class="mt-3">
                        Best vacation ever. Highly recommended!
                    </p>
                    <strong>- Priya</strong>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    ⭐⭐⭐⭐⭐
                    <p class="mt-3">
                        Beautiful stay and friendly host.
                    </p>
                    <strong>- Ananya</strong>
                </div>
            </div>
        </div>

    </div>

</section>

<!-- Newsletter -->
<section class="container mt-5 mb-5">

    <div class="card shadow-lg border-0 p-5 text-center">

        <h2>Stay Updated</h2>

        <p>
            Subscribe to receive travel deals and destination updates.
        </p>

        <div class="row justify-content-center">

            <div class="col-md-6">
                <input type="email"
                       class="form-control"
                       placeholder="Enter your email">
            </div>

            <div class="col-md-2 mt-2 mt-md-0">
                <button class="btn btn-danger w-100">
                    Subscribe
                </button>
            </div>

        </div>

    </div>

</section>